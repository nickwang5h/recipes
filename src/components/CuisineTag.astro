---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/site';

interface Props {
  cuisine: CollectionEntry<'cuisines'>;
  link?: boolean;
}

const { cuisine, link = true } = Astro.props;
const cls = `cuisine-tag accent-${cuisine.data.accent}`;
---

{link ? <a class={cls} href={url(`cuisines/${cuisine.id}`)}>{cuisine.data.title}</a> : <span class={cls}>{cuisine.data.title}</span>}
