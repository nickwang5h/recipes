---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
}

const { image, alt = '' } = Astro.props;
---

{image && (
  <figure class="cover">
    <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 448px, 100vw" loading="eager" />
    <figcaption>插图由 AI 生成</figcaption>
  </figure>
)}
