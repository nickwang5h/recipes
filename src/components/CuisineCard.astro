---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/site';

interface Props {
  cuisine: CollectionEntry<'cuisines'>;
  count?: number;
}

const { cuisine, count } = Astro.props;
const { title, original, summary, accent, cover } = cuisine.data;
---

<a class={`cuisine-hero accent-${accent}`} href={url(`cuisines/${cuisine.id}`)}>
  {cover && <Image class="card-img" src={cover} alt="" widths={[320, 480, 640]} sizes="(min-width: 48rem) 300px, 100vw" loading="lazy" />}
  <div class="cuisine-hero-body">
    <h3>{title}</h3>
    {original && <span class="original">{original}</span>}
    <p>{summary}</p>
    {count !== undefined && <p class="cuisine-count">{count} 道菜</p>}
  </div>
</a>
