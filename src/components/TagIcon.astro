---
interface Props {
  /** A recipe tag, or `season` for the in-season shortcut. */
  name: 'bento' | 'one-pot' | 'season';
  class?: string;
}

const { name, class: className } = Astro.props;
// Line icons drawn on a 16px grid in the site's stroke weight: a lunch box with a divider, a lidded pot, a leaf.
const PATHS = {
  bento: '<rect x="2" y="4.5" width="12" height="8.5" rx="1.5"/><path d="M2 7.5h12M7 7.5V13"/><path d="M5 2.5h6"/>',
  'one-pot': '<path d="M3 7.5h10v3a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z"/><path d="M1.5 7.5h13M6.5 5.5h3M8 5.5V4"/>',
  season: '<path d="M3.5 12.5c0-5 3.5-9 9-9 0 5.5-3.5 9-9 9z"/><path d="M3.5 12.5 9 7"/>',
};
---

<svg class:list={['tag-icon', className]} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PATHS[name]} />
