---
import { getEntries, type CollectionEntry } from 'astro:content';
import { HTML_LANG, langOf, type Both } from '../i18n';
import type { LineWords } from '../i18n/content';
import { WHERE_TO_BUY } from '../lib/categories';
import { countedName, formatQty, unitLabel } from '../lib/scale';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { servings, ingredients } = recipe.data;
const lang = langOf(Astro.url);
const T = {
  zh: { cook: '开始做菜', step: '第 {n} / {total} 步', prev: '上一步', next: '下一步', done: '做完了', leave: '退出做菜模式', fold: '收起', title: '配料', serves: `${servings} 人份`, servings: '份量', fewer: '减少一人份', more: '增加一人份', people: '人', wake: '屏幕常亮', reset: '重置勾选与份量', note: `配料已按新份量换算；步骤里提到的用量仍按 ${servings} 人份。`, optional: '可选' },
  en: { cook: 'Start cooking', step: 'Step {n} of {total}', prev: 'Back', next: 'Next', done: 'Done', leave: 'Leave cooking mode', fold: 'Close', title: 'Ingredients', serves: `Serves ${servings}`, servings: 'Serves', fewer: 'One serving fewer', more: 'One serving more', people: '', wake: 'Keep screen on', reset: 'Reset ticks and servings', note: `Ingredients are scaled to the new number of servings; amounts in the steps are still for ${servings}.`, optional: 'optional' },
} satisfies Both<Record<string, string>>;
const t = T[lang];
const catalog = new Map(
  (await getEntries(ingredients.flatMap((group) => group.items.map((item) => item.ref)))).map((entry) => [entry.id, entry]),
);
---

<aside class="recipe-aside" data-recipe-kit data-slug={recipe.id} data-base={servings} aria-labelledby="ingredients-title">
  <h2 id="ingredients-title">{t.title}</h2>
  <p class="servings-static">{t.serves}</p>
  <div class="kit-controls" hidden>
    <div class="servings" role="group" aria-label={t.servings}>
      <span class="servings-label">{t.servings}</span>
      <button class="icon-btn" type="button" data-step="-1" aria-label={t.fewer}>−</button>
      <output class="servings-value" aria-live="polite">{servings}</output>
      <button class="icon-btn" type="button" data-step="1" aria-label={t.more}>+</button>
      {t.people && <span class="servings-label">{t.people}</span>}
    </div>
    <div class="kit-actions">
      <button class="text-btn" type="button" data-wake hidden aria-pressed="false">{t.wake}</button>
      <button class="text-btn" type="button" data-reset>{t.reset}</button>
    </div>
  </div>
  <p class="scale-note" hidden>{t.note}</p>

  {ingredients.map((group, g) => (
    <>
      {group.group && <h3>{group.group}</h3>}
      <ul class="ingredients">
        {group.items.map((item, i) => {
          const info = catalog.get(item.ref.id)!.data;
          const { plural, word } = item as typeof item & LineWords;
          const name = item.name ?? info[lang];
          const unit = item.qty !== undefined ? unitLabel(item.unit, item.qty, lang, word) : '';
          // The other language's name helps at the shop: English in Canadian supermarkets, and on
          // the English site, the Chinese for what is bought at an Asian grocery.
          const aside = lang === 'zh' ? info.en : info.where === 'asian' ? info.zh : undefined;
          return (
          <li>
            <label class="ing-row">
              <input type="checkbox" data-ing={`${g}-${i}`} />
              <span class="ing-text">
                {item.qty !== undefined && (
                  <span class="ing-qty" data-qty={item.qty} data-unit={item.unit ?? ''} data-word={word}>
                    <span class="n">{formatQty(item.qty, item.unit)}</span>{unit && <> <span class="u">{unit}</span></>}
                  </span>
                )}
                <span class="ing-name" data-name={plural && name} data-plural={plural}>{countedName(name, plural, item.qty, item.unit)}</span>
                {item.optional && <span class="ing-tag">{t.optional}</span>}
                {info.where !== 'mainstream' && <span class={`ing-tag where-${info.where}`}>{WHERE_TO_BUY[info.where][lang]}</span>}
                {aside && <span class="ing-en" lang={HTML_LANG[lang === 'zh' ? 'en' : 'zh']}>{aside}</span>}
                {item.note && <span class="ing-note">{item.note}</span>}
              </span>
            </label>
          </li>
          );
        })}
      </ul>
    </>
  ))}
</aside>

{/* Cooking mode: phones only (≤760px). One step a screen, sharing the page's ticks and timers. */}
<button class="text-btn cook-start" type="button" data-cook-open>{t.cook}</button>
<div class="cook" data-cook hidden role="dialog" aria-modal="true" aria-labelledby="cook-title" data-step={t.step} data-next={t.next} data-done={t.done}>
  <div class="cook-bar">
    <p class="cook-title" id="cook-title"><span class="cook-name" data-cook-name></span><span class="cook-count" data-cook-count></span></p>
    <button class="cook-icon cook-ings" type="button" data-cook-ings aria-expanded="false">{t.title}</button>
    <button class="cook-icon" type="button" data-cook-close aria-label={t.leave}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <div class="cook-body" data-cook-body aria-live="polite"></div>
  <div class="cook-nav">
    <button class="cook-prev" type="button" data-cook-prev>{t.prev}</button>
    <button class="cook-next" type="button" data-cook-next>{t.next}</button>
  </div>
  <div class="cook-sheet" data-cook-sheet hidden>
    <div class="cook-sheet-head"><span>{t.title}</span><button class="text-btn" type="button" data-cook-fold>{t.fold}</button></div>
    <div class="cook-sheet-list" data-cook-list></div>
  </div>
</div>

<script>
  import { pageLang } from '../i18n';
  import { countedName, formatQty, scaleQty, unitLabel } from '../lib/scale';

  type State = { servings: number; ingredients: string[]; steps: number[] };

  const MIN = 1;
  const MAX = 24;
  const lang = pageLang();

  for (const kit of document.querySelectorAll<HTMLElement>('[data-recipe-kit]')) {
    const slug = kit.dataset.slug!;
    const base = Number(kit.dataset.base);
    const key = `recipes:v1:${slug}`;
    const controls = kit.querySelector<HTMLElement>('.kit-controls')!;
    const output = kit.querySelector('output')!;
    const note = kit.querySelector<HTMLElement>('.scale-note')!;
    const minus = kit.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const plus = kit.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const wakeBtn = kit.querySelector<HTMLButtonElement>('[data-wake]')!;
    const resetBtn = kit.querySelector<HTMLButtonElement>('[data-reset]')!;
    const ingBoxes = [...kit.querySelectorAll<HTMLInputElement>('input[data-ing]')];
    const qtys = [...kit.querySelectorAll<HTMLElement>('[data-qty]')];
    const stepItems = [...document.querySelectorAll<HTMLLIElement>('.recipe-content ol > li')];
    // The serving cat waits right under the last step and comes out once every step is ticked.
    const served = document.querySelector<HTMLElement>('[data-served]');
    if (served) stepItems.at(-1)?.parentElement?.after(served);

    const load = (): State => {
      const fallback = { servings: base, ingredients: [], steps: [] };
      try {
        const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
        if (!saved || typeof saved !== 'object') return fallback;
        const servings = Number.isInteger(saved.servings) && saved.servings >= MIN && saved.servings <= MAX ? saved.servings : base;
        return {
          servings,
          ingredients: Array.isArray(saved.ingredients) ? saved.ingredients.filter((x: unknown) => typeof x === 'string') : [],
          steps: Array.isArray(saved.steps) ? saved.steps.filter((x: unknown) => Number.isInteger(x)) : [],
        };
      } catch {
        return fallback;
      }
    };

    let state = load();

    const save = () => {
      try { localStorage.setItem(key, JSON.stringify(state)); } catch {}
    };

    const renderServings = () => {
      output.textContent = String(state.servings);
      minus.disabled = state.servings <= MIN;
      plus.disabled = state.servings >= MAX;
      note.hidden = state.servings === base;
      for (const el of qtys) {
        const unit = el.dataset.unit || undefined;
        const qty = scaleQty(Number(el.dataset.qty), base, state.servings);
        el.querySelector('.n')!.textContent = formatQty(qty, unit);
        // English plurals follow the count: "1 clove garlic", "2 cloves garlic"; "1 egg", "2 eggs".
        const u = el.querySelector('.u');
        if (u) u.textContent = unitLabel(unit, qty, lang, el.dataset.word);
        const name = el.parentElement!.querySelector<HTMLElement>('.ing-name[data-plural]');
        if (name) name.textContent = countedName(name.dataset.name!, name.dataset.plural, qty, unit);
      }
    };

    // Steps come from Markdown, so checkboxes are added here rather than at build time.
    const stepBoxes = stepItems.map((li, i) => {
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.className = 'step-check';
      box.setAttribute('aria-label', lang === 'en' ? `Step ${i + 1} done` : `第 ${i + 1} 步已完成`);
      li.classList.add('checkable');
      const hit = document.createElement('label');
      hit.className = 'step-hit';
      hit.append(box);
      li.prepend(hit);
      li.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target === box || target === hit || target.closest('a')) return;
        box.checked = !box.checked;
        box.dispatchEvent(new Event('change'));
      });
      box.addEventListener('change', () => {
        li.classList.toggle('step-done', box.checked);
        state.steps = stepBoxes.flatMap((b, j) => (b.checked ? [j] : []));
        renderServed();
        save();
      });
      return box;
    });

    const renderServed = () => {
      if (served) served.hidden = stepBoxes.length === 0 || !stepBoxes.every((b) => b.checked);
    };

    const renderChecks = () => {
      for (const box of ingBoxes) box.checked = state.ingredients.includes(box.dataset.ing!);
      stepBoxes.forEach((box, i) => {
        box.checked = state.steps.includes(i);
        stepItems[i].classList.toggle('step-done', box.checked);
      });
      renderServed();
    };

    for (const box of ingBoxes) {
      box.addEventListener('change', () => {
        state.ingredients = ingBoxes.filter((b) => b.checked).map((b) => b.dataset.ing!);
        save();
      });
    }

    for (const btn of [minus, plus]) {
      btn.addEventListener('click', () => {
        state.servings = Math.min(MAX, Math.max(MIN, state.servings + Number(btn.dataset.step)));
        renderServings();
        save();
      });
    }

    resetBtn.addEventListener('click', () => {
      state = { servings: base, ingredients: [], steps: [] };
      renderServings();
      renderChecks();
      save();
    });

    // Screen wake lock: offered only where the browser supports it.
    if ('wakeLock' in navigator) {
      let lock: WakeLockSentinel | null = null;
      let wanted = false;
      const request = async () => {
        try {
          lock = await navigator.wakeLock.request('screen');
          lock.addEventListener('release', () => {
            lock = null;
            if (!wanted) wakeBtn.setAttribute('aria-pressed', 'false');
          });
          wakeBtn.setAttribute('aria-pressed', 'true');
        } catch {
          wanted = false;
          wakeBtn.setAttribute('aria-pressed', 'false');
        }
      };
      wakeBtn.hidden = false;
      wakeBtn.addEventListener('click', async () => {
        wanted = !wanted;
        if (wanted) await request();
        else {
          await lock?.release();
          wakeBtn.setAttribute('aria-pressed', 'false');
        }
      });
      document.addEventListener('visibilitychange', () => {
        if (wanted && !lock && document.visibilityState === 'visible') request();
      });
    }

    kit.querySelector<HTMLElement>('.servings-static')!.hidden = true;
    controls.hidden = false;
    renderServings();
    renderChecks();
    if (stepBoxes.length) cookMode(kit, stepItems, stepBoxes);
  }

  // Cooking mode: the step in large type, one at a time. "Next" ticks the page's own checkbox, so the page,
  // cooking mode and the saved state never disagree; timers are the page's own timer buttons, clicked through.
  function cookMode(kit: HTMLElement, items: HTMLLIElement[], boxes: HTMLInputElement[]) {
    const root = document.querySelector<HTMLElement>('[data-cook]');
    const start = document.querySelector<HTMLElement>('[data-cook-open]');
    if (!root || !start) return;
    const $ = <E extends HTMLElement>(sel: string) => root.querySelector<E>(sel)!;
    const body = $('[data-cook-body]');
    const next = $<HTMLButtonElement>('[data-cook-next]');
    const prev = $<HTMLButtonElement>('[data-cook-prev]');
    const sheet = $('[data-cook-sheet]');
    const list = $('[data-cook-list]');
    const ings = $<HTMLButtonElement>('[data-cook-ings]');
    const parts = [...kit.querySelectorAll<HTMLElement>(':scope > h3, :scope > ul.ingredients')];
    $('[data-cook-name]').textContent = document.querySelector('h1')?.textContent ?? '';

    // Entrances: beside 常做 / 加到菜单 in the header, and a small one beside the steps heading.
    document.querySelector('.mine-bar')?.append(start);
    const heading = items[0].closest('ol')?.previousElementSibling;
    if (heading?.tagName === 'H2') {
      const small = start.cloneNode(true) as HTMLElement;
      small.classList.add('cook-start-small');
      heading.append(small);
    }

    let at = 0;
    let lock: WakeLockSentinel | null = null;
    const last = () => at === items.length - 1;

    const show = () => {
      $('[data-cook-count]').textContent = root.dataset.step!.replace('{n}', String(at + 1)).replace('{total}', String(items.length));
      const copy = items[at].cloneNode(true) as HTMLElement;
      copy.querySelector('.step-hit')?.remove();
      // The copied timers stay timer buttons (timers.ts keeps their pressed state) and start the page's own.
      for (const t of copy.querySelectorAll<HTMLElement>('.timer-btn')) {
        t.addEventListener('click', () => document.querySelector<HTMLElement>(`.recipe-content .timer-btn[data-timer="${t.dataset.timer}"]`)?.click());
        t.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); t.click(); } });
      }
      const p = document.createElement('p');
      p.className = 'cook-text';
      p.append(...copy.childNodes);
      body.replaceChildren(p);
      body.scrollTop = 0;
      prev.disabled = at === 0;
      next.textContent = last() ? root.dataset.done! : root.dataset.next!;
    };

    const hold = async () => {
      try { if (!lock && document.visibilityState === 'visible') lock = (await navigator.wakeLock?.request('screen')) ?? null; } catch {}
      lock?.addEventListener('release', () => (lock = null));
    };

    const fold = () => {
      if (sheet.hidden) return;
      kit.append(...parts);
      sheet.hidden = true;
      ings.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      const first = boxes.findIndex((b) => !b.checked);
      at = first < 0 ? 0 : first;
      show();
      root.hidden = false;
      document.body.classList.add('cooking');
      history.pushState({ cooking: true }, '');
      void hold();
      next.focus();
    };

    // Leaving goes through history, so the phone's back button and × do the same thing.
    const close = () => {
      if (root.hidden) return;
      fold();
      root.hidden = true;
      document.body.classList.remove('cooking');
      void lock?.release();
      lock = null;
      items[at].scrollIntoView({ block: 'center' });
      start.focus({ preventScroll: true });
    };

    const forward = () => {
      const box = boxes[at];
      if (!box.checked) {
        box.checked = true;
        box.dispatchEvent(new Event('change'));
      }
      if (last()) history.back();
      else { at++; show(); }
    };
    const back = () => { if (at > 0) { at--; show(); } };

    for (const b of document.querySelectorAll('[data-cook-open]')) b.addEventListener('click', open);
    next.addEventListener('click', forward);
    prev.addEventListener('click', back);
    $('[data-cook-close]').addEventListener('click', () => history.back());
    window.addEventListener('popstate', close);
    ings.addEventListener('click', () => {
      if (!sheet.hidden) return fold();
      list.append(...parts);
      sheet.hidden = false;
      ings.setAttribute('aria-expanded', 'true');
    });
    $('[data-cook-fold]').addEventListener('click', fold);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); sheet.hidden ? history.back() : fold(); }
      else if (e.key === 'ArrowRight' && sheet.hidden) forward();
      else if (e.key === 'ArrowLeft' && sheet.hidden) back();
    });
    let sx = 0, sy = 0;
    body.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    body.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 60 && Math.abs(dx) > 1.5 * Math.abs(dy)) (dx < 0 ? forward : back)();
    });
    document.addEventListener('visibilitychange', () => { if (!root.hidden) void hold(); });
    // Turning a tablet past 760px leaves the phone layout; leave cooking mode with it.
    matchMedia('(max-width: 760px)').addEventListener('change', (m) => { if (!m.matches && !root.hidden) history.back(); });
  }
</script>
