---
// The line-drawn dumpling on the Ko-fi button: body, five pleats, and three wisps of steam
// that only show while it is pointed at. Strokes take the text colour of whatever holds it.
---

<svg class="kofi-dumpling" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <g>
    <path class="steam s1" d="M8.2 6.1c-.9-1 .9-1.9 0-3.1" />
    <path class="steam s2" d="M12 5.4c-.9-1 .9-1.9 0-3.1" />
    <path class="steam s3" d="M15.8 6.1c-.9-1 .9-1.9 0-3.1" />
    <path class="body" d="M2.3 13.6c.5-.2 1 .1 1.3.6 3.4 5.9 13.4 5.9 16.8 0 .3-.5.8-.8 1.3-.6C20.2 5.2 3.8 5.2 2.3 13.6Z" />
    <path class="pleat" d="M6.8 9.8l1 2.3M9.5 8.7l.6 2.5M12.2 8.3l.1 2.6M14.9 8.6l-.4 2.5M17.5 9.6l-.8 2.3" />
  </g>
</svg>
