---
// Inlines a hand-written SVG diagram (src/assets/diagrams/<slug>.svg) so it can use the
// page's color tokens and follow dark mode. Renders nothing when no diagram exists.
//
// Each diagram is drawn once, 600 wide, with its own phone layout (src/lib/diagram.ts): both are
// rendered and a container query in global.css shows the phone one in narrow columns, where the
// 600-wide drawing would shrink its words below 12px.
// English pages use the translated copy in diagrams/en/; without one they show no diagram.
import { langOf } from '../i18n';
import { diagramLayouts } from '../lib/diagram';

interface Props {
  slug: string;
}

const svgs = import.meta.glob<string>('../assets/diagrams/**/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = svgs[`../assets/diagrams/${langOf(Astro.url) === 'en' ? 'en/' : ''}${Astro.props.slug}.svg`];
const scope = `dg-${Astro.props.slug}`;
const d = raw && diagramLayouts(raw, scope);
---

{d && (
  <figure class="diagram" id={scope} data-narrow={d.narrow ? '' : undefined}>
    <Fragment set:html={d.wide} />
    {d.narrow && (
      <div class="diagram-narrow">
        {d.narrow.lead && <p class="diagram-lead" set:html={d.narrow.lead} />}
        <Fragment set:html={d.narrow.svg} />
        {d.narrow.notes.length > 0 && (
          <ul class="diagram-notes">
            {d.narrow.notes.map((n) => <li set:html={n} />)}
          </ul>
        )}
      </div>
    )}
    {d.caption && <figcaption>{d.caption}</figcaption>}
  </figure>
)}
