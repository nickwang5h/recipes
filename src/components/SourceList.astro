---
interface Props {
  sources: { title: string; author?: string; url?: string }[];
}

const { sources } = Astro.props;
---

<h2 class="section-title">参考来源</h2>
<ol class="sources">
  {sources.map((s) => (
    <li>
      {s.author && <>{s.author}，</>}
      {s.url ? <a href={s.url} rel="noopener">{s.title}</a> : <cite>{s.title}</cite>}
    </li>
  ))}
</ol>
