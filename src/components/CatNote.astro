---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** One of the poses in src/assets/cats/; what the cat holds should match the state. */
  cat: ImageMetadata;
  /** Hidden until a script shows it, e.g. "no results". */
  hidden?: boolean;
  [attr: `data-${string}`]: string | boolean | undefined;
}

const { cat, hidden, ...data } = Astro.props;
---

<div class="cat-note" hidden={hidden} {...data}>
  {/* One fixed size, no srcset: the offline page's copy is precached by exact URL. */}
  <span class="cat-note-ground"><Image class="cat-note-cat" src={cat} alt="" width={320} loading="lazy" /></span>
  <div class="cat-note-text"><slot /></div>
</div>
