---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import logoCat from '../assets/cats/logo.png';
import waveCat from '../assets/cats/wave.png';
import KofiButton from '../components/KofiButton.astro';
import '../styles/global.css';
import '../styles/kitchen.css';
import '../styles/phone.css';
import { HTML_LANG, OG_LOCALE, langOf, switchPath, url, type Both } from '../i18n';
import { MAIN_SITE, SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';
import pageFonts from '../data/page-fonts.json';

interface Props {
  title?: string;
  description?: string;
  /** Share preview; falls back to the site card. */
  image?: ImageMetadata;
  /** og:type, e.g. "article" for recipes and principles. */
  type?: string;
  /** A narrower column for pages that are mostly pictures, like the home page. */
  narrow?: boolean;
  /** Whether this page exists in the other language; an untranslated recipe has no English twin. */
  twin?: boolean;
}

const lang = langOf(Astro.url);
const other = lang === 'zh' ? 'en' : 'zh';
const { title, description = SITE_DESCRIPTION[lang], image, type = 'website', narrow = false, twin = true } = Astro.props;
const ogImage = new URL(image ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src : lang === 'en' ? '/og-default-en.png' : '/og-default.png', Astro.site);
const fullTitle = title ? `${title} · ${SITE_TITLE[lang]}` : SITE_TITLE[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// The page's own path within its language, for marking the current section.
const local = switchPath(path, 'zh');
const otherPath = twin ? switchPath(path, other) : url('', other);
// This page's own small font files (scripts/build-web-fonts.py): its less common characters, so it
// doesn't fetch whole shared slices for one or two of them.
type PageFont = { family: string; weight: string; src: string; range: string };
const fonts = pageFonts as { css: string; pages: Record<string, PageFont[]> };
const ownFonts = (fonts.pages[path] ?? [])
  .map((f) => `@font-face{font-family:"${f.family}";src:url('${f.src}') format('woff2');font-style:normal;font-weight:${f.weight};font-display:fallback;unicode-range:${f.range}}`)
  .join('');
const T = {
  zh: { skip: '跳到正文', nav: '主导航', search: '搜索', theme: '切换深浅色', tagline: '家常菜和背后的道理', switchTo: 'English', switchLabel: 'Read this page in English', short: 'Ki饭', top: '回到顶部' },
  en: { skip: 'Skip to content', nav: 'Main', search: 'Search', theme: 'Switch light or dark', tagline: 'Home cooking and the reasons behind it', switchTo: '中文', switchLabel: '中文版', short: "Kiki's", top: 'Back to top' },
} satisfies Both<Record<string, string>>;
const t = T[lang];
// Four places, the same on every screen: today (the home page, with the fridge and the week's menu
// behind it), the recipes (with cuisines, principles and search), the shopping list, and what's saved.
const NAV = [
  { path: '', label: { zh: '今天', en: 'Today' }, match: /^\/(menu|fridge)?\/?$/ },
  { path: 'recipes', label: { zh: '菜谱', en: 'Recipes' }, match: /^\/(recipes|cuisines|principles|search)\// },
  { path: 'list', label: { zh: '清单', en: 'List' }, match: /^\/list\// },
  { path: 'mine', label: { zh: '我的', en: 'Saved' }, match: /^\/mine\// },
];
const nav = NAV.map((item) => ({ href: url(item.path, lang), label: item.label[lang], on: item.match.test(local) }));
// Wide screens have room for two more in the header: 菜系 and 冰箱 get their own place there, instead of
// only a link inside 菜谱 and the block on 今天. Phones keep the four tabs.
const HEAD = [
  { ...NAV[0], match: /^\/(menu)?\/?$/ },
  { ...NAV[1], match: /^\/(recipes|principles|search)\// },
  { path: 'cuisines', label: { zh: '菜系', en: 'Cuisines' }, match: /^\/cuisines\// },
  { path: 'fridge', label: { zh: '冰箱', en: 'Fridge' }, match: /^\/fridge\// },
  NAV[2],
  NAV[3],
];
const head = HEAD.map((item) => ({ href: url(item.path, lang), label: item.label[lang], on: item.match.test(local) }));
// Phones (≤760px) get a bottom bar of four places instead of the header; a recipe has its own bar.
const recipePage = /^\/recipes\/[^/]+\/$/.test(local);
const ICONS: Record<string, string> = {
  '': '<path d="M3.5 11.5h17a8.5 8.5 0 0 1-17 0Z"/><path d="M8 20.5h8"/><path d="M9 4.5c-.8 1 .8 2 0 3.2M13 4c-.8 1 .8 2 0 3.2"/>',
  recipes: '<path d="M5 4.5h11a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3Z"/><path d="M5 16.5a3 3 0 0 1 3-3h11"/><path d="M9 8h6"/>',
  list: '<path d="M6 3.5h12v17H6Z"/><path d="M9 8.5l1.2 1.2L12.5 7.5M9 14h6M9 17h4"/>',
  mine: '<path d="M12 20s-7.5-4.6-7.5-10.1A4.4 4.4 0 0 1 12 7.1a4.4 4.4 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20Z"/>',
};
const TABS = NAV.map((item, i) => ({ ...nav[i], id: item.path || 'today', icon: ICONS[item.path] }));
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={HTML_LANG[lang]} href={canonical} />
    {twin && <link rel="alternate" hreflang={HTML_LANG[other]} href={new URL(otherPath, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="manifest" href={lang === 'zh' ? '/manifest.webmanifest' : '/en/manifest.webmanifest'} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={t.short} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_TITLE[lang]} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The shared font faces don't hold up the first paint: text starts in the fallback font either way. */}
    <link rel="stylesheet" href={fonts.css} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts.css} /></noscript>
    <slot name="head" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11120f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('recipes:theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
          // A theme picked by hand: the browser bar follows it, not the system setting.
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = theme === 'dark' ? '#11120f' : '#f3f0e8';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class={narrow ? 'narrow' : undefined}>
    {/* After the site stylesheet, so these faces come first for their characters. */}
    {ownFonts && <style is:inline set:html={ownFonts} />}
    <a class="visually-hidden" href="#main">{t.skip}</a>
    <header class="site-header" data-home={local === '/' ? '' : undefined}>
      <div class="wrap">
        <a class="brand" href={url('', lang)}><Image class="brand-cat" src={logoCat} alt="" width={72} height={72} loading="eager" />{SITE_TITLE[lang]}</a>
        <nav class="site-nav" aria-label={t.nav}>
          {head.map((item) => (
            <a href={item.href} aria-current={item.on ? 'page' : undefined}>{item.label}{item.href.endsWith('/list/') && <span class="nav-badge" data-list-badge hidden></span>}</a>
          ))}
          <a class="lang-switch" href={otherPath} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]} aria-label={t.switchLabel}>{lang === 'zh' ? 'EN' : '中'}</a>
          <KofiButton head />
          <button class="theme-toggle" type="button" aria-label={t.theme} data-theme-toggle>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <span class="footer-cat" aria-hidden="true"><Image src={waveCat} alt="" width={176} loading="lazy" /></span>
      <div class="wrap">
        <span>{SITE_TITLE[lang]} · {t.tagline}</span>
        <span class="footer-links">
          <a href={otherPath} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]}>{t.switchTo}</a>
          <a href={MAIN_SITE}>nickwang.xyz</a>
        </span>
      </div>
    </footer>
    {/* Back to the top of a long page: shows when you scroll back up, a couple of screens down. */}
    <div class="float-actions" hidden data-float>
      <button class="to-top" type="button" aria-label={t.top} data-to-top>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6M6 11l6-6 6 6" /></svg>
      </button>
    </div>
    {!recipePage && (
      <nav class="tabbar" aria-label={t.nav}>
        {TABS.map((tab) => (
          <a href={tab.href} data-tab={tab.id} aria-current={tab.on ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon} />
            <span>{tab.label}</span>
            {tab.id === 'list' && <span class="tab-badge" data-list-badge hidden></span>}
          </a>
        ))}
      </nav>
    )}
    <script>
      import { get, subscribe } from '../scripts/store';
      import { listItems } from '../scripts/shopping-list';
      import '../scripts/timers';

      // The header button, and on phones the row in 我的.
      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('recipes:theme', next); } catch {}
          for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) meta.content = next === 'dark' ? '#11120f' : '#f3f0e8';
          document.dispatchEvent(new Event('themechange'));
        });
      }

      // The 清单 tab and link: how many things are left to buy.
      const renderListCount = () => {
        const left = listItems().filter((i) => !i.bought).length;
        for (const badge of document.querySelectorAll<HTMLElement>('[data-list-badge]')) {
          badge.hidden = left === 0;
          badge.textContent = String(left);
        }
      };
      subscribe(renderListCount);
      renderListCount();

      // Going home: the name, or the place you are in (the current tab or nav link) tapped again,
      // takes you to the top of this page instead of reloading it.
      const toTop = () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a.brand, .tabbar a, .site-nav a')) {
        link.addEventListener('click', (event) => {
          if (link.pathname !== location.pathname || event.metaKey || event.ctrlKey || event.shiftKey) return;
          event.preventDefault();
          toTop();
        });
      }
      // The back-to-top button: only while scrolling back up, two screens or more down the page.
      // (A page can add its own button beside it, as the principle pages do with 目录.)
      const float = document.querySelector<HTMLElement>('[data-float]')!;
      let lastY = scrollY;
      addEventListener('scroll', () => {
        const y = scrollY;
        if (y < innerHeight * 2) float.hidden = true;
        else if (y < lastY - 4) float.hidden = false;
        else if (y > lastY + 4) float.hidden = true;
        lastY = y;
      }, { passive: true });
      document.querySelector('[data-to-top]')!.addEventListener('click', () => {
        toTop();
        float.hidden = true;
        document.querySelector<HTMLElement>('main')?.focus({ preventScroll: true });
      });

      // Mark the family's 常做 dishes on every recipe card, server- or client-rendered.
      // Loading the store here also keeps family sync running on every page.
      const markFavorites = () => {
        for (const card of document.querySelectorAll<HTMLAnchorElement>('a.card[href*="/recipes/"]')) {
          const id = card.pathname.replace(/^\/en\//, '/').split('/').filter(Boolean)[1];
          card.classList.toggle('is-fav', get('fav:' + id) === true);
        }
      };
      subscribe(markFavorites);
      new MutationObserver(markFavorites).observe(document.querySelector('main')!, { childList: true, subtree: true });
      markFavorites();

      // Swipeable filter rows fade at the right edge until they are scrolled to the end (styled on phones only).
      for (const row of document.querySelectorAll<HTMLElement>('.filters')) {
        const update = () => row.classList.toggle('at-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 2);
        row.addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      }

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
