---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import logoCat from '../assets/cats/logo.png';
import waveCat from '../assets/cats/wave.png';
import KofiButton from '../components/KofiButton.astro';
import '../styles/global.css';
import '../styles/phone.css';
import { HTML_LANG, OG_LOCALE, langOf, switchPath, url, type Both } from '../i18n';
import { MAIN_SITE, SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Share preview; falls back to the site card. */
  image?: ImageMetadata;
  /** og:type, e.g. "article" for recipes and principles. */
  type?: string;
  /** A narrower column for pages that are mostly pictures, like the home page. */
  narrow?: boolean;
  /** Whether this page exists in the other language; an untranslated recipe has no English twin. */
  twin?: boolean;
}

const lang = langOf(Astro.url);
const other = lang === 'zh' ? 'en' : 'zh';
const { title, description = SITE_DESCRIPTION[lang], image, type = 'website', narrow = false, twin = true } = Astro.props;
const ogImage = new URL(image ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src : '/og-default.png', Astro.site);
const fullTitle = title ? `${title} · ${SITE_TITLE[lang]}` : SITE_TITLE[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// The page's own path within its language, for marking the current section.
const local = switchPath(path, 'zh');
const otherPath = twin ? switchPath(path, other) : url('', other);
const T = {
  zh: { skip: '跳到正文', nav: '主导航', search: '搜索', theme: '切换深浅色', tagline: '家常菜和背后的道理', switchTo: 'English', switchLabel: 'Read this page in English', short: 'Ki饭' },
  en: { skip: 'Skip to content', nav: 'Main', search: 'Search', theme: 'Switch light or dark', tagline: 'Home cooking and the reasons behind it', switchTo: '中文', switchLabel: '中文版', short: "Kiki's" },
} satisfies Both<Record<string, string>>;
const t = T[lang];
const NAV = [
  { path: 'cuisines', label: { zh: '菜系', en: 'Cuisines' } },
  { path: 'principles', label: { zh: '原理', en: 'Science' } },
  { path: 'recipes', label: { zh: '菜谱', en: 'Recipes' } },
  { path: 'fridge', label: { zh: '冰箱', en: 'Fridge' } },
  { path: 'menu', label: { zh: '菜单', en: 'Menu' } },
  { path: 'mine', label: { zh: '我的', en: 'Saved' } },
];
const nav = NAV.map((item) => ({ href: url(item.path, lang), label: item.label[lang], match: `/${item.path}/` }));
// Phones (≤760px) get a bottom bar of four places instead of the header; a recipe has its own bar.
const recipePage = /^\/recipes\/[^/]+\/$/.test(local);
const TABS = [
  { id: 'home', href: url('', lang), label: { zh: '首页', en: 'Home' }, on: local === '/', icon: '<path d="M3.5 11.5h17a8.5 8.5 0 0 1-17 0Z"/><path d="M8 20.5h8"/><path d="M9 4.5c-.8 1 .8 2 0 3.2M13 4c-.8 1 .8 2 0 3.2"/>' },
  { id: 'recipes', href: url('recipes', lang), label: { zh: '菜谱', en: 'Recipes' }, on: /^\/(recipes|cuisines|principles|search|fridge)\//.test(local), icon: '<path d="M5 4.5h11a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3Z"/><path d="M5 16.5a3 3 0 0 1 3-3h11"/><path d="M9 8h6"/>' },
  { id: 'list', href: url('menu', lang), label: { zh: '清单', en: 'List' }, on: local.startsWith('/menu/'), icon: '<path d="M6 3.5h12v17H6Z"/><path d="M9 8.5l1.2 1.2L12.5 7.5M9 14h6M9 17h4"/>' },
  { id: 'mine', href: url('mine', lang), label: { zh: '我的', en: 'Saved' }, on: local.startsWith('/mine/'), icon: '<path d="M12 20s-7.5-4.6-7.5-10.1A4.4 4.4 0 0 1 12 7.1a4.4 4.4 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20Z"/>' },
];
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={HTML_LANG[lang]} href={canonical} />
    {twin && <link rel="alternate" hreflang={HTML_LANG[other]} href={new URL(otherPath, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href={lang === 'zh' ? '/manifest.webmanifest' : '/en/manifest.webmanifest'} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={t.short} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_TITLE[lang]} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11120f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('recipes:theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class={narrow ? 'narrow' : undefined}>
    <a class="visually-hidden" href="#main">{t.skip}</a>
    <header class="site-header" data-home={local === '/' ? '' : undefined}>
      <div class="wrap">
        <a class="brand" href={url('', lang)}><Image class="brand-cat" src={logoCat} alt="" width={72} height={72} loading="eager" />{SITE_TITLE[lang]}</a>
        <nav class="site-nav" aria-label={t.nav}>
          {nav.map((item) => (
            <a href={item.href} aria-current={local.startsWith(item.match) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="nav-icon" href={url('search', lang)} aria-label={t.search} aria-current={local.startsWith('/search/') ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" stroke-linecap="round" /></svg>
          </a>
          <a class="lang-switch" href={otherPath} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]} aria-label={t.switchLabel}>{lang === 'zh' ? 'EN' : '中'}</a>
          <KofiButton head />
          <button class="theme-toggle" type="button" aria-label={t.theme} data-theme-toggle>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <span class="footer-cat" aria-hidden="true"><Image src={waveCat} alt="" width={176} loading="lazy" /></span>
      <div class="wrap">
        <span>{SITE_TITLE[lang]} · {t.tagline}</span>
        <span class="footer-links">
          <a href={otherPath} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]}>{t.switchTo}</a>
          <a href={MAIN_SITE}>nickwang.xyz</a>
        </span>
      </div>
    </footer>
    {!recipePage && (
      <nav class="tabbar" aria-label={t.nav}>
        {TABS.map((tab) => (
          <a href={tab.href} data-tab={tab.id} aria-current={tab.on ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon} />
            <span>{tab.label[lang]}</span>
            {tab.id === 'list' && <span class="tab-badge" data-list-badge hidden></span>}
          </a>
        ))}
      </nav>
    )}
    <script>
      import { get, subscribe } from '../scripts/store';
      import { listItems } from '../scripts/shopping-list';
      import '../scripts/timers';

      // The header button, and on phones the row in 我的.
      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('recipes:theme', next); } catch {}
          document.dispatchEvent(new Event('themechange'));
        });
      }

      // The 清单 tab: how many things are left to buy, and straight to the list when there is one.
      const listTab = document.querySelector<HTMLAnchorElement>('.tabbar [data-tab="list"]');
      if (listTab) {
        const menu = listTab.pathname;
        const badge = listTab.querySelector<HTMLElement>('[data-list-badge]')!;
        const renderTab = () => {
          const items = listItems();
          const left = items.filter((i) => !i.bought).length;
          badge.hidden = left === 0;
          badge.textContent = String(left);
          listTab.href = items.length ? `${menu}#list` : menu;
        };
        subscribe(renderTab);
        renderTab();
      }

      // Mark the family's 常做 dishes on every recipe card, server- or client-rendered.
      // Loading the store here also keeps family sync running on every page.
      const markFavorites = () => {
        for (const card of document.querySelectorAll<HTMLAnchorElement>('a.card[href*="/recipes/"]')) {
          const id = card.pathname.replace(/^\/en\//, '/').split('/').filter(Boolean)[1];
          card.classList.toggle('is-fav', get('fav:' + id) === true);
        }
      };
      subscribe(markFavorites);
      new MutationObserver(markFavorites).observe(document.querySelector('main')!, { childList: true, subtree: true });
      markFavorites();

      // Swipeable filter rows fade at the right edge until they are scrolled to the end (styled on phones only).
      for (const row of document.querySelectorAll<HTMLElement>('.filters')) {
        const update = () => row.classList.toggle('at-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 2);
        row.addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      }

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
