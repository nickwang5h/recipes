---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import logoCat from '../assets/cats/logo.png';
import waveCat from '../assets/cats/wave.png';
import '../styles/global.css';
import { MAIN_SITE, SITE_DESCRIPTION, SITE_TITLE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Share preview; falls back to the site card. */
  image?: ImageMetadata;
  /** og:type, e.g. "article" for recipes and principles. */
  type?: string;
  /** A narrower column for pages that are mostly pictures, like the home page. */
  narrow?: boolean;
}

const { title, description = SITE_DESCRIPTION, image, type = 'website', narrow = false } = Astro.props;
const ogImage = new URL(image ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src : '/og-default.png', Astro.site);
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: url('cuisines'), label: '菜系', match: '/cuisines/' },
  { href: url('principles'), label: '原理', match: '/principles/' },
  { href: url('recipes'), label: '菜谱', match: '/recipes/' },
  { href: url('fridge'), label: '冰箱', match: '/fridge/' },
  { href: url('menu'), label: '菜单', match: '/menu/' },
  { href: url('mine'), label: '我的', match: '/mine/' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="猫饭" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <meta name="theme-color" content="#f3f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11120f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('recipes:theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class={narrow ? 'narrow' : undefined}>
    <a class="visually-hidden" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}><Image class="brand-cat" src={logoCat} alt="" width={72} height={72} loading="eager" />{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.match) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="nav-icon" href={url('search')} aria-label="搜索" aria-current={path.startsWith('/search/') ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" stroke-linecap="round" /></svg>
          </a>
          <button class="theme-toggle" type="button" aria-label="切换深浅色" data-theme-toggle>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <span class="footer-cat" aria-hidden="true"><Image src={waveCat} alt="" width={176} loading="lazy" /></span>
      <div class="wrap">
        <span>{SITE_TITLE} · 家常菜和背后的道理</span>
        <a href={MAIN_SITE}>nickwang.xyz</a>
      </div>
    </footer>
    <script>
      import { get, subscribe } from '../scripts/store';
      import '../scripts/timers';

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('recipes:theme', next); } catch {}
      });

      // Mark the family's 常做 dishes on every recipe card, server- or client-rendered.
      // Loading the store here also keeps family sync running on every page.
      const markFavorites = () => {
        for (const card of document.querySelectorAll<HTMLAnchorElement>('a.card[href*="/recipes/"]')) {
          const id = card.pathname.split('/').filter(Boolean)[1];
          card.classList.toggle('is-fav', get('fav:' + id) === true);
        }
      };
      subscribe(markFavorites);
      new MutationObserver(markFavorites).observe(document.querySelector('main')!, { childList: true, subtree: true });
      markFavorites();

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
