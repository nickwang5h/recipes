---
import Base from '../../layouts/Base.astro';
import CatNote from '../../components/CatNote.astro';
import { langPaths, url, type Both, type Lang } from '../../i18n';
import potCat from '../../assets/cats/search-empty.png';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = {
  zh: {
    title: '搜索', description: '按菜名、食材或原理搜索全站的菜谱和笔记。', lede: '按菜名、食材、做法或原理搜索，比如“茄子”“红烧”“乳化”。',
    placeholder: '搜索菜谱和原理…', byType: '按类型筛选', all: '全部', recipe: '菜谱', principle: '原理', cuisine: '菜系',
    none: '锅里空空的', noneText: '没有找到。换个说法试试，比如只搜主料“茄子”，或者做法“红烧”。', browse: '翻翻全部菜谱',
  },
  en: {
    title: 'Search', description: 'Search every recipe and science page by dish, ingredient or technique.', lede: 'Search by dish, ingredient, method or principle, for example “eggplant”, “braise” or “emulsion”.',
    placeholder: 'Search recipes and science…', byType: 'Filter by type', all: 'All', recipe: 'Recipes', principle: 'Science', cuisine: 'Cuisines',
    none: 'The pot’s empty', noneText: 'Nothing found. Try other words, such as just the main ingredient (“eggplant”) or the method (“braise”).', browse: 'Browse all recipes',
  },
} satisfies Both<Record<string, string>>;
const t = T[lang];
---

<Base title={t.title} description={t.description}>
  <header class="page-head">
    <h1>{t.title}</h1>
    <p class="lede">{t.lede}</p>
  </header>

  <label class="search-box">
    <span class="visually-hidden">{t.title}</span>
    <input type="search" placeholder={t.placeholder} autocomplete="off" autofocus data-q />
  </label>
  <nav class="filters chips search-filters" aria-label={t.byType} data-types>
    <button class="chip" type="button" data-type="" aria-pressed="true">{t.all}</button>
    <button class="chip" type="button" data-type="recipe" aria-pressed="false">{t.recipe}</button>
    <button class="chip" type="button" data-type="principle" aria-pressed="false">{t.principle}</button>
    <button class="chip" type="button" data-type="cuisine" aria-pressed="false">{t.cuisine}</button>
  </nav>

  <p class="filter-count" data-count aria-live="polite"></p>
  <ol class="search-results" data-results></ol>
  <CatNote cat={potCat} hidden data-none>
    <p class="cat-note-title">{t.none}</p>
    <p>{t.noneText}</p>
    <p><a class="cat-note-btn" href={url('recipes', lang)}>{t.browse}</a></p>
  </CatNote>

  <script>
    import { loadIndex, mountSearch } from '../../scripts/search-ui';

    const filter = mountSearch({
      input: document.querySelector<HTMLInputElement>('[data-q]')!,
      list: document.querySelector<HTMLElement>('[data-results]')!,
      count: document.querySelector<HTMLElement>('[data-count]')!,
      none: document.querySelector<HTMLElement>('[data-none]')!,
    });
    document.querySelector('[data-types]')!.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!button) return;
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-types] button')) b.setAttribute('aria-pressed', String(b === button));
      filter(button.dataset.type ?? '');
    });
    void loadIndex().catch(() => {});
  </script>
</Base>
