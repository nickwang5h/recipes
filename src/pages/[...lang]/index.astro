---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langPaths, url, type Both, type Lang } from '../../i18n';
import heroCats from '../../assets/cats/hero-duo.png';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
// 今天: a tool for tonight, not a feed. Tonight's dishes and what they still need, what the fridge
// can make, and the week ahead; everything is filled in on the device (src/scripts/today.ts).
const T = {
  zh: {
    title: '今天', tonight: '今晚', lucky: '今晚吃什么？', table: '配一桌',
    heroAlt: '两只暹罗猫在灶台前一起做饭：一只站在小板凳上颠锅，一只在旁边尝汤',
    fridge: '冰箱', edit: '改冰箱里的', fridgeEmpty: '还没选冰箱里有什么。选几样手头的食材，这里会列出能做的菜。', pick: '选冰箱里有什么',
    week: '这周', menu: '排菜单', recipes: '翻翻菜谱',
  },
  en: {
    title: 'Today', tonight: 'Tonight', lucky: 'What’s for dinner?', table: 'Set a table',
    heroAlt: 'Two Siamese cats cooking together at the stove: one stands on a little stool tossing the wok, the other tastes the soup',
    fridge: 'Fridge', edit: 'Edit the fridge', fridgeEmpty: 'Nothing picked yet. Choose a few things you have, and the dishes you can make show up here.', pick: 'Pick what’s in the fridge',
    week: 'This week', menu: 'Plan the week', recipes: 'Browse recipes',
  },
} satisfies Both<Record<string, string>>;
const t = T[lang];
---

<Base narrow>
  <div class="today" data-today>
    <header class="today-head">
      <h1>{t.title}</h1>
      <p class="today-date" data-today-date></p>
    </header>

    <div class="today-grid">
      <section class="index-card tonight" aria-labelledby="tonight-title">
        <h2 id="tonight-title">{t.tonight}</h2>
        <div class="tonight-empty" data-tonight-empty>
          <Image class="tonight-cats" src={heroCats} alt={t.heroAlt} widths={[480, 720, 1080]} sizes="(min-width: 900px) 560px, 100vw" loading="eager" />
          <div class="tonight-acts">
            <a class="home-lucky" href={`${url('recipes', lang)}?lucky`} data-draw>{t.lucky}</a>
            <button class="text-btn" type="button" data-table>{t.table}</button>
          </div>
        </div>
        <ul class="tonight-dishes" data-tonight hidden></ul>
        <div class="tonight-foot" data-tonight-foot hidden></div>
      </section>

      <section class="today-fridge" aria-labelledby="fridge-title">
        <div class="today-sec-head">
          <h2 id="fridge-title">{t.fridge}</h2>
          <a href={url('fridge', lang)} data-fridge-edit data-title={t.fridge}>{t.edit}</a>
        </div>
        <ul class="today-have" data-fridge-have></ul>
        <div class="today-fridge-empty" data-fridge-empty>
          <p>{t.fridgeEmpty}</p>
          <a class="cat-note-btn" href={url('fridge', lang)} data-fridge-edit data-title={t.fridge}>{t.pick}</a>
        </div>
        <ul class="card-grid today-matches" data-matches></ul>
        <a class="today-more" href={url('fridge', lang)} data-matches-more hidden></a>
      </section>
    </div>

    <section class="today-week" aria-labelledby="week-title">
      <div class="today-sec-head">
        <h2 id="week-title">{t.week}</h2>
        <a href={url('menu', lang)}>{t.menu}</a>
      </div>
      {/* Seven empty days hold the space until the device fills in its own dates. */}
      <ol class="week" data-week>
        {Array.from({ length: 7 }, () => <li class="day"><span class="day-head"></span></li>)}
      </ol>
    </section>
  </div>

  <script>
    import '../../scripts/today';
  </script>
</Base>
