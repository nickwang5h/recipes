---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CuisineCard from '../components/CuisineCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { PRINCIPLE_CATEGORIES, type PrincipleCategory } from '../lib/categories';
import { SITE_TITLE, formatDate, getCuisines, url } from '../lib/site';

const cuisines = await getCuisines();
const principles = await getCollection('principles');
const recipes = await getCollection('recipes');

const recent = [
  ...recipes.map((r) => ({ kind: '菜谱', href: url(`recipes/${r.id}`), title: r.data.title, updated: r.data.updated })),
  ...principles.map((p) => ({ kind: '原理', href: url(`principles/${p.id}`), title: p.data.title, updated: p.data.updated })),
]
  .sort((a, b) => b.updated.getTime() - a.updated.getTime())
  .slice(0, 6);

const count = (id: string) => recipes.filter((r) => r.data.cuisine.id === id).length;
const cuisineMap = new Map(cuisines.map((c) => [c.id, c]));

// A handful of illustrated dishes, one cuisine at a time so no single cuisine crowds the
// row; the starting point moves with the build date so the home page doesn't go stale.
const recipeById = new Map(recipes.map((r) => [r.id, r]));
const lists = cuisines.map((c) => c.data.featured.map((ref) => recipeById.get(ref.id)!).filter((r) => r?.data.cover));
const picks: typeof recipes = [];
const day = Math.floor(Date.now() / 86_400_000);
for (let round = 0; picks.length < 8 && lists.some((l) => l.length > round); round++) {
  for (const list of lists) {
    const r = list[(round + day) % Math.max(list.length, 1)];
    if (r && !picks.includes(r) && picks.length < 8) picks.push(r);
  }
}

const byCategory = (Object.keys(PRINCIPLE_CATEGORIES) as PrincipleCategory[])
  .map((category) => ({ category, items: principles.filter((p) => p.data.category === category) }))
  .filter((g) => g.items.length > 0);
---

<Base>
  <header class="page-head">
    <h1>{SITE_TITLE}</h1>
    <p class="lede">
      中餐、法餐、意大利菜，还有泰国、越南、日本、韩国的家常菜，背后常常是同几条物理和化学规律：油和水怎样被留在一起，淀粉什么时候变稠，表面为什么会变褐变香。这里把原理和菜谱分开写，再用链接串起来，做菜时查步骤，闲下来看为什么。
    </p>
    <form class="home-search search-box" action={url('search')} method="get" role="search">
      <label class="visually-hidden" for="home-q">搜索</label>
      <input id="home-q" type="search" name="q" placeholder="搜菜名、食材或原理" autocomplete="off" />
    </form>
  </header>

  <section aria-labelledby="cuisines-title">
    <div class="section-head">
      <h2 id="cuisines-title" class="section-title">菜系</h2>
      <a href={url('recipes')}>全部 {recipes.length} 道菜 →</a>
    </div>
    <div class="cuisine-hero-grid">
      {cuisines.map((c) => <CuisineCard cuisine={c} count={count(c.id)} />)}
    </div>
  </section>

  {picks.length > 0 && (
    <section aria-labelledby="picks-title">
      <div class="section-head">
        <h2 id="picks-title" class="section-title">挑几道菜</h2>
        <a href={url('fridge')}>按冰箱里的食材找 →</a>
      </div>
      <ul class="card-grid">
        {picks.map((r) => <li><RecipeCard recipe={r} cuisine={cuisineMap.get(r.data.cuisine.id)!} /></li>)}
      </ul>
    </section>
  )}

  <section aria-labelledby="principles-title">
    <div class="section-head">
      <h2 id="principles-title" class="section-title">原理</h2>
      <a href={url('principles')}>全部原理 →</a>
    </div>
    <div class="principle-groups">
      {byCategory.map(({ category, items }) => (
        <div>
          <h3>{PRINCIPLE_CATEGORIES[category]}</h3>
          <ul class="chips">
            {items.map((p) => <li><a class="chip" href={url(`principles/${p.id}`)}>{p.data.title}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="recent-title">
    <h2 id="recent-title" class="section-title">最近更新</h2>
    <ul class="link-list">
      {recent.map((item) => (
        <li>
          <a href={item.href}>
            <span class="title">{item.title}</span>
            <span class="meta">{item.kind} · {formatDate(item.updated)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
