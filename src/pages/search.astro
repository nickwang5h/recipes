---
import Base from '../layouts/Base.astro';
---

<Base title="搜索" description="按菜名、食材或原理搜索全站的菜谱和笔记。">
  <header class="page-head">
    <h1>搜索</h1>
    <p class="lede">按菜名、食材、做法或原理搜索，比如“茄子”“红烧”“乳化”。</p>
  </header>

  <label class="search-box">
    <span class="visually-hidden">搜索</span>
    <input type="search" placeholder="搜索菜谱和原理…" autocomplete="off" autofocus data-q />
  </label>
  <nav class="filters chips search-filters" aria-label="按类型筛选" data-types>
    <button class="chip" type="button" data-type="" aria-pressed="true">全部</button>
    <button class="chip" type="button" data-type="菜谱" aria-pressed="false">菜谱</button>
    <button class="chip" type="button" data-type="原理" aria-pressed="false">原理</button>
    <button class="chip" type="button" data-type="菜系" aria-pressed="false">菜系</button>
  </nav>

  <p class="filter-count" data-count aria-live="polite"></p>
  <ol class="search-results" data-results></ol>

  <script>
    import { search, terms, type SearchHit } from '../lib/search';
    import type { SearchDoc } from './search-index.json';

    const input = document.querySelector<HTMLInputElement>('[data-q]')!;
    const list = document.querySelector<HTMLOListElement>('[data-results]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const PAGE = 30;
    let type = '';
    let docs: SearchDoc[] | null = null;

    const load = async () => {
      if (!docs) {
        try {
          docs = await (await fetch('/search-index.json')).json();
        } catch {
          count.textContent = '搜索索引加载失败，请检查网络。';
        }
      }
      return docs;
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}) =>
      Object.assign(document.createElement(tag), props);

    /** Text with every query term wrapped in <mark>, built from DOM nodes so nothing is parsed as HTML. */
    const highlighted = (text: string, qs: string[]) => {
      const p = el('p', { className: 'search-excerpt' });
      const pattern = new RegExp(`(${qs.map((q) => q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
      for (const part of text.split(pattern)) {
        if (!part) continue;
        p.append(qs.includes(part.toLowerCase()) ? el('mark', { textContent: part }) : document.createTextNode(part));
      }
      return p;
    };

    const row = (hit: SearchHit, qs: string[]) => {
      const { doc } = hit;
      const a = el('a', { className: 'search-hit', href: doc.u });
      if (doc.img) a.append(el('img', { src: doc.img, alt: '', loading: 'lazy', width: 96, height: 64 }));
      const text = el('div');
      text.append(el('span', { className: 'search-title', textContent: doc.t }));
      text.append(el('span', { className: 'search-kind', textContent: [doc.k, doc.c].filter(Boolean).join(' · ') }));
      text.append(highlighted(hit.excerpt, qs));
      a.append(text);
      const li = el('li');
      li.append(a);
      return li;
    };

    const run = async () => {
      const q = input.value.trim();
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
      if (!q) {
        list.replaceChildren();
        count.textContent = '';
        return;
      }
      const all = await load();
      if (!all) return;
      const hits = search(all, q, type);
      count.textContent = hits.length
        ? `${hits.length} 条结果${hits.length > PAGE ? `，显示前 ${PAGE} 条` : ''}`
        : '没有找到，换个说法试试。';
      const qs = terms(q);
      list.replaceChildren(...hits.slice(0, PAGE).map((hit) => row(hit, qs)));
    };

    let timer = 0;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(run, 120);
    });
    document.querySelector('[data-types]')!.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!button) return;
      type = button.dataset.type ?? '';
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-types] button')) b.setAttribute('aria-pressed', String(b === button));
      run();
    });

    input.value = new URLSearchParams(location.search).get('q') ?? '';
    if (input.value) run();
    else load();
  </script>
</Base>
