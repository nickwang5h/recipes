---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PrincipleCard from '../../components/PrincipleCard.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getCuisines, url } from '../../lib/site';

export async function getStaticPaths() {
  const cuisines = await getCuisines();
  return cuisines.map((cuisine) => ({ params: { slug: cuisine.id }, props: { cuisine } }));
}

const { cuisine } = Astro.props;
const { title, original, summary, accent } = cuisine.data;
const principles = await Promise.all(cuisine.data.principles.map((ref) => getEntry(ref)));
const featured = await Promise.all(cuisine.data.featured.map((ref) => getEntry(ref)));
const { Content } = await render(cuisine);
// Only the chinese page has regional sub-pages.
const regions = cuisine.id === 'chinese' ? (await getCollection('regions')).sort((a, b) => a.data.order - b.data.order) : [];
---

<Base title={title} description={summary}>
  <article class={`accent-${accent}`}>
    <header class="page-head">
      <div class="eyebrow"><span class={`cuisine-tag accent-${accent}`}>菜系</span></div>
      <h1>{title}</h1>
      {original && <p class="original">{original}</p>}
      <p class="lede">{summary}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {regions.length > 0 && (
      <section>
        <h2 class="section-title">地方菜</h2>
        <ul class="card-grid">
          {regions.map((r) => (
            <li>
              <a class={`card accent-${accent}`} href={url(`cuisines/chinese/${r.id}`)}>
                <h3>{r.data.title}</h3>
                {r.data.original && <span class="original">{r.data.original}</span>}
                <p>{r.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {featured.length > 0 && (
      <section>
        <h2 class="section-title">代表菜</h2>
        <ul class="card-grid">
          {featured.map((recipe) => <li><RecipeCard recipe={recipe} cuisine={cuisine} /></li>)}
        </ul>
        <p><a href={`${url('recipes')}?cuisine=${cuisine.id}`}>全部{title}菜谱 →</a></p>
      </section>
    )}

    {principles.length > 0 && (
      <section>
        <h2 class="section-title">核心原理</h2>
        <ul class="card-grid">
          {principles.map((principle) => <li><PrincipleCard principle={principle} /></li>)}
        </ul>
      </section>
    )}
  </article>
</Base>
