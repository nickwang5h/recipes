---
import Base from '../layouts/Base.astro';
---

<Base title="离线" description="没有网络时显示的页面，列出已经保存在这台设备上的内容。">
  <header class="page-head">
    <h1>现在没有网络</h1>
    <p class="lede">这一页还没有保存在这台设备上。下面是已经保存、可以离线打开的内容。</p>
  </header>

  <p class="fridge-empty" data-saved-empty>还没有离线保存的页面。联网时打开过的页面会自动保存；也可以在“菜谱”页一次保存全部菜谱。</p>
  <div data-saved></div>

  <script>
    const GROUPS: [string, string][] = [
      ['/recipes/', '菜谱'],
      ['/principles/', '原理'],
      ['/cuisines/', '菜系'],
    ];

    const render = async () => {
      if (!('caches' in window)) return;
      const cache = await caches.open('pages');
      const entries: { path: string; title: string }[] = [];
      for (const request of await cache.keys()) {
        const path = new URL(request.url).pathname;
        if (path === '/offline/') continue;
        const html = await (await cache.match(request))!.text();
        const title = html.match(/<title>([^<]*?)(?: · [^<]*)?<\/title>/)?.[1] ?? path;
        entries.push({ path, title });
      }
      const root = document.querySelector<HTMLElement>('[data-saved]')!;
      for (const [prefix, label] of GROUPS) {
        const items = entries
          .filter((e) => e.path.startsWith(prefix) && e.path !== prefix)
          .sort((a, b) => a.title.localeCompare(b.title, 'zh'));
        if (!items.length) continue;
        const h2 = Object.assign(document.createElement('h2'), { className: 'section-title', textContent: `${label} · ${items.length}` });
        const ul = Object.assign(document.createElement('ul'), { className: 'chips' });
        for (const item of items) {
          const a = Object.assign(document.createElement('a'), { className: 'chip', href: item.path, textContent: item.title });
          const li = document.createElement('li');
          li.append(a);
          ul.append(li);
        }
        root.append(h2, ul);
      }
      document.querySelector<HTMLElement>('[data-saved-empty]')!.hidden = entries.length > 0;
    };
    render();
  </script>
</Base>
