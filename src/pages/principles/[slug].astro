---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Diagram from '../../components/Diagram.astro';
import SourceList from '../../components/SourceList.astro';
import { PRINCIPLE_CATEGORIES } from '../../lib/categories';
import { formatDate, getCuisines, recipesUsing, url } from '../../lib/site';

export async function getStaticPaths() {
  const principles = await getCollection('principles');
  return principles.map((principle) => ({ params: { slug: principle.id }, props: { principle } }));
}

const { principle } = Astro.props;
const { title, aliases, category, summary, sources, updated } = principle.data;
const related = await Promise.all(principle.data.related.map((ref) => getEntry(ref)));
const cuisines = await getCuisines();
const users = recipesUsing(principle.id, await getCollection('recipes'));
const cuisineOrder = new Map(cuisines.map((c, i) => [c.id, i]));
users.sort(
  (a, b) =>
    cuisineOrder.get(a.data.cuisine.id)! - cuisineOrder.get(b.data.cuisine.id)! ||
    a.data.title.localeCompare(b.data.title, 'zh'),
);
const cuisineById = new Map(cuisines.map((c) => [c.id, c]));
// Cards for dishes that hinge on this principle; a compact list for the rest.
const primary = users.filter((r) => r.data.principles[0].id === principle.id);
const secondary = users.filter((r) => r.data.principles[0].id !== principle.id);
const { Content } = await render(principle);
---

<Base title={title} description={summary}>
  <article>
    <header class="page-head">
      <div class="eyebrow">
        <a href={url('principles')}>原理</a>
        <span>{PRINCIPLE_CATEGORIES[category]}</span>
      </div>
      <h1>{title}</h1>
      {aliases.length > 0 && <p class="original">{aliases.join(' · ')}</p>}
      <p class="lede">{summary}</p>
    </header>

    <Diagram slug={principle.id} />

    <div class="prose">
      <Content />
    </div>

    {related.length > 0 && (
      <section>
        <h2 class="section-title">相关原理</h2>
        <ul class="chips">
          {related.map((p) => <li><a class="chip" href={url(`principles/${p.id}`)}>{p.data.title}</a></li>)}
        </ul>
      </section>
    )}

    {users.length > 0 && (
      <section>
        <h2 class="section-title">用到它的菜</h2>
        {primary.length > 0 && (
          <ul class="card-grid">
            {primary.map((recipe) => <li><RecipeCard recipe={recipe} cuisine={cuisineById.get(recipe.data.cuisine.id)!} /></li>)}
          </ul>
        )}
        {secondary.length > 0 && (
          <details class="more-recipes" open={primary.length === 0}>
            <summary>{primary.length > 0 ? `还有 ${secondary.length} 道菜也用到它` : `${secondary.length} 道菜`}</summary>
            <ul class="chips">
              {secondary.map((r) => <li><a class="chip" href={url(`recipes/${r.id}`)}>{r.data.title}</a></li>)}
            </ul>
          </details>
        )}
      </section>
    )}

    <div class="prose">
      <SourceList sources={sources} />
      <p style="color: var(--muted); font-size: 0.9rem">更新于 {formatDate(updated)}</p>
    </div>
  </article>
</Base>
