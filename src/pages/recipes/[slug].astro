---
import { getImage } from 'astro:assets';
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import CatNote from '../../components/CatNote.astro';
import serveCat from '../../assets/cats/serve.png';
import RecipeMine from '../../components/RecipeMine.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import CuisineTag from '../../components/CuisineTag.astro';
import RecipeKit from '../../components/RecipeKit.astro';
import SourceList from '../../components/SourceList.astro';
import NutritionPanel from '../../components/NutritionPanel.astro';
import { COURSES } from '../../lib/categories';
import { recipeLd } from '../../lib/jsonld';
import { related } from '../../lib/related';
import { SITE_TITLE, formatDate, formatTime, getCuisineMap, url } from '../../lib/site';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { title, original, summary, time, sources, updated } = recipe.data;
const cuisine = await getEntry(recipe.data.cuisine);
const principles = await Promise.all(recipe.data.principles.map((ref) => getEntry(ref)));
const { Content } = await render(recipe);

const all = await getCollection('recipes');
const shape = (r: (typeof all)[number]) => ({
  id: r.id,
  cuisine: r.data.cuisine.id,
  course: r.data.course,
  principles: r.data.principles.map((p) => p.id),
  ingredients: r.data.ingredients.flatMap((g) => g.items.filter((i) => !i.optional).map((i) => i.ref.id)),
  entry: r,
});
const cuisineMap = await getCuisineMap();
const relatedRecipes = related(shape(recipe), all.map(shape)).map((r) => r.entry);

const items = recipe.data.ingredients.flatMap((g) => g.items);
const catalog = await getEntries(items.map((i) => i.ref));
const ld = recipeLd({
  url: new URL(url(`recipes/${recipe.id}`), Astro.site).href,
  title,
  summary,
  cuisine: cuisine.data.title,
  course: COURSES[recipe.data.course],
  servings: recipe.data.servings,
  time,
  ingredients: items.map((item, n) => ({ qty: item.qty, unit: item.unit, name: item.name ?? catalog[n].data.zh, note: item.note })),
  body: recipe.body ?? '',
  keywords: principles.map((p) => p.data.title),
  image: recipe.data.cover && new URL((await getImage({ src: recipe.data.cover, width: 1200, format: 'jpg' })).src, Astro.site).href,
  updated,
  site: { name: SITE_TITLE, url: new URL('/', Astro.site).href },
});
---

<Base title={title} description={summary} image={recipe.data.cover} type="article">
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(ld)} />
  <article>
    <div class="hero">
      <header class="page-head">
        <div class="eyebrow">
          <CuisineTag cuisine={cuisine} />
          <span>{formatTime(time)}</span>
        </div>
        <h1>{title}</h1>
        {original && <p class="original">{original}</p>}
        <p class="lede">{summary}</p>
        {principles.length > 0 && (
          <nav aria-label="用到的原理" style="margin-top: 1.25rem">
            <ul class="chips">
              {principles.map((p) => <li><a class="chip" href={url(`principles/${p.id}`)}>{p.data.title}</a></li>)}
            </ul>
          </nav>
        )}
        <RecipeMine id={recipe.id} />
      </header>
      <Cover image={recipe.data.cover} alt={recipe.data.coverAlt} stamp={time.prep + time.cook <= 30 ? '快手' : undefined} />
    </div>

    <div class="recipe-layout">
      <RecipeKit recipe={recipe} />
      <div class="prose recipe-body">
        <div class="recipe-content"><Content /></div>
        <CatNote cat={serveCat} hidden data-served>
          <p class="cat-note-title">开饭啦</p>
          <p>步骤都做完了，趁热吃。</p>
        </CatNote>
        <NutritionPanel recipe={recipe} />
        <SourceList sources={sources} />
        <p class="meta" style="color: var(--muted); font-size: 0.9rem">更新于 {formatDate(updated)}</p>
      </div>
    </div>

    {relatedRecipes.length > 0 && (
      <section class="related-recipes">
        <h2 class="section-title">相关的菜</h2>
        <ul class="card-grid">
          {relatedRecipes.map((r) => <li><RecipeCard recipe={r} cuisine={cuisineMap.get(r.data.cuisine.id)!} /></li>)}
        </ul>
      </section>
    )}
  </article>
</Base>
