---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { COURSES, INGREDIENT_KINDS, TIME_LIMITS, type Course, type IngredientKind } from '../lib/categories';
import { ALWAYS_HAVE, DEFAULT_STAPLES } from '../lib/fridge';
import { formatTotal, getCuisines, url } from '../lib/site';

const cuisines = await getCuisines();
const order = new Map(cuisines.map((c, i) => [c.id, i]));
const recipes = (await getCollection('recipes')).sort(
  (a, b) => order.get(a.data.cuisine.id)! - order.get(b.data.cuisine.id)! || a.data.title.localeCompare(b.data.title, 'zh'),
);
const catalog = await getCollection('ingredients');

// How many recipes use each ingredient; the pickers list common ones first.
const uses = new Map<string, number>();
const rec = await Promise.all(recipes.map(async (r) => {
  const all = new Set(r.data.ingredients.flatMap((g) => g.items.map((i) => i.ref.id)));
  for (const id of all) uses.set(id, (uses.get(id) ?? 0) + 1);
  const req = [...new Set(r.data.ingredients.flatMap((g) => g.items.filter((i) => !i.optional).map((i) => i.ref.id)))];
  return {
    id: r.id,
    href: url(`recipes/${r.id}`),
    title: r.data.title,
    summary: r.data.summary,
    cuisine: r.data.cuisine.id,
    course: r.data.course,
    time: formatTotal(r.data.time),
    minutes: r.data.time.prep + r.data.time.cook,
    img: r.data.cover ? (await getImage({ src: r.data.cover, width: 480, format: 'webp' })).src : undefined,
    req,
  };
}));

const hidden = new Set([...ALWAYS_HAVE, ...DEFAULT_STAPLES]);
const used = catalog.filter((i) => uses.has(i.id) || catalog.some((o) => uses.has(o.id) && o.data.substitutes.some((s) => s.id === i.id)));
const byUse = (a: (typeof catalog)[number], b: (typeof catalog)[number]) => (uses.get(b.id) ?? 0) - (uses.get(a.id) ?? 0);
const kinds = (Object.keys(INGREDIENT_KINDS) as IngredientKind[])
  .map((kind) => ({ kind, items: used.filter((i) => i.data.kind === kind && !hidden.has(i.id)).sort(byUse) }))
  .filter((g) => g.items.length > 0);
const staples = DEFAULT_STAPLES.map((id) => catalog.find((i) => i.id === id)!);
const usedCourses = (Object.keys(COURSES) as Course[]).filter((c) => recipes.some((r) => r.data.course === c));

const data = {
  ingredients: used
    .filter((i) => !ALWAYS_HAVE.includes(i.id))
    .sort(byUse)
    .map((i) => ({
      id: i.id,
      zh: i.data.zh,
      en: i.data.en,
      where: i.data.where,
      names: [i.data.zh, ...i.data.aliases, i.data.en],
      subs: i.data.substitutes.map((s) => s.id),
    })),
  recipes: rec,
  cuisines: Object.fromEntries(cuisines.map((c) => [c.id, { title: c.data.title, accent: c.data.accent }])),
  staples: DEFAULT_STAPLES,
};
---

<Base title="冰箱" description="选出手头有的食材，看看能做哪些菜，还差什么。">
  <header class="page-head">
    <h1>冰箱</h1>
    <p class="lede">选出手头有的食材，看看能做哪些菜。差一两样的也列出来，顺便知道该买什么。</p>
  </header>

  <div class="fridge-layout">
    <aside class="recipe-aside fridge-picker" aria-label="选择食材">
      <label class="fridge-search">
        <span class="visually-hidden">搜索食材</span>
        <input type="search" placeholder="搜索：鸡蛋、番茄、pork…" autocomplete="off" data-search />
      </label>
      <ul class="chips fridge-suggest" data-suggest aria-live="polite"></ul>

      <div class="fridge-have-head">
        <h2>我有</h2>
        <button class="text-btn" type="button" data-clear hidden>清空</button>
      </div>
      <ul class="chips" data-have></ul>
      <p class="fridge-empty" data-have-empty>还没选。搜索或在下面的类别里点选。</p>

      <details class="fridge-group">
        <summary>常备调料 <span class="fridge-count" data-staple-count></span></summary>
        <p class="fridge-help">默认视为家里有，没有的点一下取消。清水总是算有。</p>
        <ul class="chips">
          {staples.map((i) => <li><button class="chip pick" type="button" data-id={i.id} aria-pressed="true">{i.data.zh}</button></li>)}
        </ul>
      </details>

      {kinds.map(({ kind, items }) => (
        <details class="fridge-group">
          <summary>{INGREDIENT_KINDS[kind]} <span class="fridge-count" data-kind-count={kind}></span></summary>
          <ul class="chips" data-kind={kind}>
            {items.map((i) => <li><button class="chip pick" type="button" data-id={i.id} aria-pressed="false">{i.data.zh}</button></li>)}
          </ul>
        </details>
      ))}
    </aside>

    <section class="fridge-results" aria-label="可以做的菜">
      <nav class="filters chips" aria-label="按类型筛选" data-course-filter>
        <button class="chip" type="button" data-course="" aria-pressed="true">全部</button>
        {usedCourses.map((c) => <button class="chip" type="button" data-course={c} aria-pressed="false">{COURSES[c]}</button>)}
      </nav>
      <nav class="filters chips" aria-label="按用时筛选" data-time-filter>
        <button class="chip" type="button" data-time="" aria-pressed="true">不限时间</button>
        {Object.entries(TIME_LIMITS).map(([id, t]) => <button class="chip" type="button" data-time={id} aria-pressed="false">{t.label}</button>)}
      </nav>

      <details class="shopping-list" data-list-wrap open hidden>
        <summary><h2 class="section-title">购物清单 <span class="fridge-count" data-list-count></span></h2></summary>
        <div data-list></div>
        <div class="kit-actions shopping-actions">
          <button class="text-btn" type="button" data-list-copy>复制清单</button>
          <button class="text-btn" type="button" data-list-stock>买到的放进冰箱</button>
          <button class="text-btn" type="button" data-list-clear>清空</button>
          <span class="offline-status" data-list-status aria-live="polite"></span>
        </div>
      </details>

      <p class="fridge-empty" data-hint>先在左边选几样食材。</p>

      <div data-ready-wrap hidden>
        <h2 class="section-title">现在就能做 <span class="fridge-count" data-ready-count></span></h2>
        <ul class="card-grid" data-ready></ul>
      </div>
      <div data-almost-wrap hidden>
        <h2 class="section-title">差一两样 <span class="fridge-count" data-almost-count></span></h2>
        <ul class="card-grid" data-almost></ul>
        <button class="text-btn fridge-more" type="button" data-more hidden></button>
      </div>
      <p class="fridge-empty" data-none hidden>没有找到合适的菜。多选几样食材试试。</p>
    </section>
  </div>

  <script type="application/json" id="fridge-data" set:html={JSON.stringify(data)} />

  <script>
    import { withinTime, type WhereToBuy } from '../lib/categories';
    import { matchRecipes, searchIngredients, type Match } from '../lib/fridge';
    import { addMissing, grouped, toText, type ListItem } from '../lib/shopping';

    interface Ingredient { id: string; zh: string; en: string; where: WhereToBuy; names: string[]; subs: string[] }
    interface Recipe { id: string; href: string; title: string; summary: string; cuisine: string; course: string; time: string; minutes: number; img?: string; req: string[] }
    interface Data {
      ingredients: Ingredient[];
      recipes: Recipe[];
      cuisines: Record<string, { title: string; accent: string }>;
      staples: string[];
    }

    const STORE = 'recipes:v1:fridge';
    const PLATE = '<svg viewBox="0 0 120 72" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="60" cy="38" rx="54" ry="28"/><ellipse cx="60" cy="38" rx="36" ry="17"/></svg>';
    const PAGE = 24;
    const data: Data = JSON.parse(document.getElementById('fridge-data')!.textContent!);
    const byId = new Map(data.ingredients.map((i) => [i.id, i]));
    const substitutes = Object.fromEntries(data.ingredients.filter((i) => i.subs.length).map((i) => [i.id, i.subs]));
    const isStaple = (id: string) => data.staples.includes(id);
    const nameOf = (id: string) => byId.get(id)?.zh ?? id;
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

    // State: chosen ingredients, plus the staples the cook says they lack.
    let chosen = new Set<string>();
    let staplesOff = new Set<string>();
    let list: ListItem[] = [];
    let course = '';
    let time = '';
    let shown = PAGE;
    try {
      const saved = JSON.parse(localStorage.getItem(STORE) ?? '{}');
      chosen = new Set((saved.chosen ?? []).filter((id: string) => byId.has(id) && !isStaple(id)));
      staplesOff = new Set((saved.staplesOff ?? []).filter(isStaple));
      list = (saved.list ?? []).filter((item: ListItem) => byId.has(item.id));
    } catch {}

    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify({ chosen: [...chosen], staplesOff: [...staplesOff], list })); } catch {}
    };
    const catalog = new Map(data.ingredients.map((i) => [i.id, i]));
    const isOn = (id: string) => (isStaple(id) ? !staplesOff.has(id) : chosen.has(id));
    const setOn = (id: string, on: boolean) => {
      if (isStaple(id)) on ? staplesOff.delete(id) : staplesOff.add(id);
      else on ? chosen.add(id) : chosen.delete(id);
      shown = PAGE;
      save();
      render();
    };

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, ...kids: (Node | string)[]) => {
      const node = Object.assign(document.createElement(tag), props);
      node.append(...kids);
      return node;
    };

    const pickButton = (id: string, label = nameOf(id)) => {
      const b = el('button', { type: 'button', className: 'chip pick', textContent: label });
      b.dataset.id = id;
      b.setAttribute('aria-pressed', String(isOn(id)));
      return el('li', {}, b);
    };

    const card = (m: Match<Recipe>) => {
      const r = m.recipe;
      const c = data.cuisines[r.cuisine];
      const body = el('div', { className: 'card-body' }, el('h3', { textContent: r.title }));
      if (m.missing.length) body.append(el('p', { className: 'fridge-missing', textContent: `还缺：${m.missing.map(nameOf).join('、')}` }));
      if (m.swaps.length)
        body.append(el('p', { className: 'fridge-swap', textContent: m.swaps.map(([need, sub]) => `用${nameOf(sub)}代替${nameOf(need)}`).join('；') }));
      body.append(
        el('p', { className: 'card-summary', textContent: r.summary }),
        el('div', { className: 'meta' }, el('span', { className: `cuisine-tag accent-${c.accent}`, textContent: c.title }), el('span', { textContent: r.time })),
      );
      const a = el('a', { className: `card has-cover accent-${c.accent}`, href: r.href });
      if (r.img) {
        const img = document.createElement('img');
        Object.assign(img, { className: 'card-img', src: r.img, alt: '', loading: 'lazy', width: 480, height: 320 });
        a.append(img);
      } else {
        const ph = el('div', { className: 'card-img card-ph', innerHTML: PLATE });
        ph.setAttribute('aria-hidden', 'true');
        a.append(ph);
      }
      a.append(body);
      const li = el('li', { className: 'fridge-card' }, a);
      if (m.missing.length) {
        const listed = () => m.missing.every((id) => list.some((item) => item.id === id && item.for.includes(r.title)));
        const add = el('button', { type: 'button', className: 'text-btn add-to-list', textContent: listed() ? '已在购物清单里' : '缺的加入购物清单' });
        add.disabled = listed();
        add.addEventListener('click', () => {
          list = addMissing(list, r.title, m.missing);
          save();
          renderList();
          add.textContent = '已在购物清单里';
          add.disabled = true;
        });
        li.append(add);
      }
      return li;
    };

    function renderList() {
      $('[data-list-wrap]').hidden = list.length === 0;
      $('[data-list-count]').textContent = `· ${list.filter((i) => !i.bought).length} 样`;
      $('[data-list]').replaceChildren(
        ...grouped(list, catalog).map((group) => {
          const ul: HTMLUListElement = el('ul', { className: 'ingredients' });
          ul.append(
              ...group.items.map((item) => {
                const info = catalog.get(item.id)!;
                const box = document.createElement('input');
                box.type = 'checkbox';
                box.checked = item.bought;
                box.addEventListener('change', () => {
                  item.bought = box.checked;
                  save();
                  renderList();
                });
                const text: HTMLSpanElement = el('span', { className: 'ing-text' });
                text.append(
                  el('span', { className: 'ing-name', textContent: info.zh }),
                  el('span', { className: 'ing-en', textContent: info.en }),
                  el('span', { className: 'ing-note', textContent: `用于：${item.for.join('、')}` }),
                );
                const label = document.createElement('label');
                label.className = 'ing-row';
                label.append(box, text);
                const li: HTMLLIElement = el('li');
                li.append(label);
                return li;
              }),
          );
          const div: HTMLDivElement = el('div', { className: 'shopping-group' });
          div.append(el('h3', { textContent: group.label }), ul);
          return div;
        }),
      );
    }

    const listStatus = (text: string) => {
      $('[data-list-status]').textContent = text;
      setTimeout(() => ($('[data-list-status]').textContent = ''), 2500);
    };
    $('[data-list-copy]').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(toText(list, catalog));
        listStatus('已复制');
      } catch {
        listStatus('复制失败，请手动选择文字');
      }
    });
    $('[data-list-stock]').addEventListener('click', () => {
      const bought = list.filter((i) => i.bought);
      if (!bought.length) return listStatus('先勾选买到的');
      list = list.filter((i) => !i.bought);
      for (const item of bought) setOn(item.id, true);
      save();
      renderList();
    });
    $('[data-list-clear]').addEventListener('click', () => {
      list = [];
      save();
      renderList();
      render();
    });

    const search = $<HTMLInputElement>('[data-search]');
    const renderSuggest = () => {
      const hits = searchIngredients(data.ingredients, search.value);
      $('[data-suggest]').replaceChildren(...hits.map((i) => pickButton(i.id)));
    };

    function render() {
      // Pickers rendered on the server and in the suggestion list.
      for (const b of document.querySelectorAll<HTMLButtonElement>('button.pick')) b.setAttribute('aria-pressed', String(isOn(b.dataset.id!)));
      for (const list of document.querySelectorAll<HTMLElement>('[data-kind]')) {
        const n = [...list.querySelectorAll<HTMLButtonElement>('button.pick')].filter((b) => chosen.has(b.dataset.id!)).length;
        $(`[data-kind-count="${list.dataset.kind}"]`).textContent = n ? `· ${n}` : '';
      }
      $('[data-staple-count]').textContent = `· ${data.staples.length - staplesOff.size}/${data.staples.length}`;

      const have = [...chosen].sort((a, b) => nameOf(a).localeCompare(nameOf(b), 'zh'));
      $('[data-have]').replaceChildren(...have.map((id) => pickButton(id, `${nameOf(id)} ×`)));
      $('[data-have-empty]').hidden = have.length > 0;
      $('[data-clear]').hidden = have.length === 0;

      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-course-filter] button'))
        b.setAttribute('aria-pressed', String(b.dataset.course === course));

      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-time-filter] button'))
        b.setAttribute('aria-pressed', String(b.dataset.time === time));

      const pool = data.recipes.filter((r) => (!course || r.course === course) && withinTime(time, r.minutes));
      const staples = new Set(data.staples.filter((id) => !staplesOff.has(id)));
      const matches = matchRecipes(pool, { chosen, staples, substitutes, maxMissing: 2 });
      const ready = matches.filter((m) => m.missing.length === 0);
      if (time) ready.sort((x, y) => x.recipe.minutes - y.recipe.minutes);
      const almost = matches.filter((m) => m.missing.length > 0);

      $('[data-hint]').hidden = chosen.size > 0;
      $('[data-none]').hidden = chosen.size === 0 || matches.length > 0;
      $('[data-ready-wrap]').hidden = ready.length === 0;
      $('[data-ready-count]').textContent = `· ${ready.length}`;
      $('[data-ready]').replaceChildren(...ready.map(card));
      $('[data-almost-wrap]').hidden = almost.length === 0;
      $('[data-almost-count]').textContent = `· ${almost.length}`;
      $('[data-almost]').replaceChildren(...almost.slice(0, shown).map(card));
      const more = $<HTMLButtonElement>('[data-more]');
      more.hidden = almost.length <= shown;
      more.textContent = `再显示 ${Math.min(PAGE, almost.length - shown)} 道`;
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const pick = target.closest<HTMLButtonElement>('button.pick');
      if (pick) {
        const id = pick.dataset.id!;
        // A suggestion always adds; elsewhere the chip toggles.
        const fromSuggest = !!pick.closest('[data-suggest]');
        setOn(id, fromSuggest ? true : !isOn(id));
        if (fromSuggest) {
          search.value = '';
          renderSuggest();
          search.focus();
        }
        return;
      }
      const courseBtn = target.closest<HTMLButtonElement>('[data-course-filter] button');
      if (courseBtn) {
        course = courseBtn.dataset.course ?? '';
        shown = PAGE;
        render();
        return;
      }
      const timeBtn = target.closest<HTMLButtonElement>('[data-time-filter] button');
      if (timeBtn) {
        time = timeBtn.dataset.time ?? '';
        shown = PAGE;
        render();
        return;
      }
      if (target.closest('[data-more]')) {
        shown += PAGE;
        render();
        return;
      }
      if (target.closest('[data-clear]')) {
        chosen.clear();
        shown = PAGE;
        save();
        render();
      }
    });

    search.addEventListener('input', renderSuggest);
    search.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      const [first] = searchIngredients(data.ingredients, search.value, 1);
      if (!first) return;
      setOn(first.id, true);
      search.value = '';
      renderSuggest();
    });

    renderList();
    render();
  </script>
</Base>
